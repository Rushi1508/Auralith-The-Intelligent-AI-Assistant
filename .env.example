# Copy to .env and edit. Never commit .env.
#
# The inherited prototype hardcoded `os.environ["OPENAI_API_KEY"] = ""` in two
# source files, which both embedded a secret in version control and silently
# overwrote any key the user had legitimately exported. Nothing in auralith/
# reads a key directly any more - it all goes through auralith.config.Settings.

# ---- Provider -------------------------------------------------------------
# "ollama" (default, local, free) or "openai".
AURALITH_PROVIDER=ollama

# ---- Local (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
AURALITH_GENERATOR_MODEL=llama3.2:3b
# Judge is deliberately a larger, different model than the generator so it is
# not grading its own output. See eval/judge.py.
AURALITH_JUDGE_MODEL=qwen2.5:7b

# ---- Embeddings and reranking (local, run on CPU) -------------------------
AURALITH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AURALITH_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- OpenAI (only needed when AURALITH_PROVIDER=openai) --------------------
# OPENAI_API_KEY=sk-...

# ---- Tuning ---------------------------------------------------------------
# 0.0 everywhere: eval runs must be reproducible.
AURALITH_TEMPERATURE=0.0
AURALITH_TIMEOUT=120

# ---- Web search tool (Phase D) --------------------------------------------
# Backend is "ddgs" (default, keyless) or "tavily".
AURALITH_SEARCH_BACKEND=ddgs
# TAVILY_API_KEY=tvly-...

# Optional: hosted generator (judge/embeddings stay local). Free key: aistudio.google.com
# AURALITH_GENERATOR_PROVIDER=gemini
# AURALITH_GENERATOR_MODEL=<model id from AI Studio>
# GEMINI_API_KEY=

# ---- API (Phase I-1) ------------------------------------------------------
AURALITH_API_URL=http://localhost:8000
# AURALITH_MAX_UPLOAD_MB=25
