# Render free web service (512 MB / 0.1 CPU): thin API. Gemini embeddings, no local models,
# no reranker, Postgres vectors. DATABASE_URL is required at runtime (no Chroma in this image).
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 TIKTOKEN_CACHE_DIR=/models/tiktoken WEB_CONCURRENCY=1 \
    AURALITH_EMBEDDING_PROVIDER=gemini AURALITH_RERANK_PROVIDER=none
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
# Bake the tokenizer so cold starts never download.
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base'); tiktoken.get_encoding('gpt2')"
COPY auralith auralith
# uvicorn reads WEB_CONCURRENCY; Render supplies PORT.
CMD sh -c "exec uvicorn auralith.api:app --host 0.0.0.0 --port ${PORT:-8000}"
